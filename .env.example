# Local PostgreSQL (safe development values only)
POSTGRES_DB=bardi
POSTGRES_USER=bardi
POSTGRES_PASSWORD=bardi-development-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django (safe development values only; replace for any deployed environment)
DJANGO_SECRET_KEY=django-development-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1
