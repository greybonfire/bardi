# Server-only Django origin. Never put secrets or a NEXT_PUBLIC_ prefix here.
BARDI_API_ORIGIN=http://127.0.0.1:8000
# Exact public origin for browser POST validation and SEO; required in production.
# No trailing slash, path, credentials, query or fragment.
BARDI_SITE_ORIGIN=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
