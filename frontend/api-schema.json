              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
