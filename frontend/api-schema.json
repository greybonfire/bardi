  "info": {
    "description": "Stateless planning API. Pinned Fact derivation and redacted contradiction handling run before Procedure selection, version resolution, applicability, trust evaluation, and evidence-backed Checklist assembly.",
    "title": "Bardi public API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/planning": {
      "post": {
        "operationId": "api_api_planning",
        "parameters": [],
